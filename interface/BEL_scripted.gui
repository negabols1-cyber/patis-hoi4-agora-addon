@COUNTRY_NAMES_X = 20
@COUNT_ICON_X = 350
@COUNT_ICON_HOL_Y = 35 #-5 less than GUI Elements
@COUNT_ICON_LUX_Y = 65 #-5 less than GUI Elements
@CHECKBOX_BUTTON_X = 275
@INTEGRATION_TEXT_X = 343
@INTEGRATION_PERCENTAGE_X = 380
@GUI_ELEMENTS_HOL_Y = 40
@GUI_ELEMENTS_LUX_Y = 70

guiTypes = {
	containerWindowType = {
		name = "integrate_benelux_container"
		position = { x = 0 y = 0 }
		size = { width = 100% height= 100 }

		instantTextBoxType = {
			name = "integration_text"
			font = "garamond_16"
			text = BEL_integration_text
			maxHeight = 24
			format = left
			position = { x = @INTEGRATION_TEXT_X y = 15 }
		}

		instantTextBoxType = {
			name = "netherlands_name"
			font = "garamond_24"
			text = "BEL_netherlands_name"
			maxWidth = 220
			maxHeight = 24
			format = left
			position = { x = @COUNTRY_NAMES_X y = @GUI_ELEMENTS_HOL_Y }
		}

		iconType = {
			name = "count_icon"
			spriteType = "GFX_div_count_bg"
			orientation = left
			position = { x = @COUNT_ICON_X y = 35 }
		}

		instantTextBoxType = {
			name = "integration_percentage"
			font = "garamond_24"
			text = "integration_percentage_hol"
			maxWidth = 100
			format = left
			position = { x = @INTEGRATION_PERCENTAGE_X y = @GUI_ELEMENTS_HOL_Y }
		}

		iconType = {
			name = "decision_checkbox_hol_disable" 
			position = { x = @CHECKBOX_BUTTON_X y = @GUI_ELEMENTS_HOL_Y }
			quadTextureSprite = "GFX_deploy_priority"
			pdx_tooltip = BEL_decision_checkbox_tooltip
			pdx_tooltip_delayed = BEL_decision_checkbox_disabled
			frame = 2
		}
		iconType = {
			name = "decision_checkbox_hol_unavailable" 
			position = { x = @CHECKBOX_BUTTON_X y = @GUI_ELEMENTS_HOL_Y }
			quadTextureSprite = "GFX_deploy_priority"
			pdx_tooltip = BEL_decision_checkbox_hol_unavailable_tooltip
			frame = 3
		}
		buttonType = {
			name = "decision_checkbox_hol_available" 
			position = { x = @CHECKBOX_BUTTON_X y = @GUI_ELEMENTS_HOL_Y }
			quadTextureSprite = "GFX_deploy_priority"
			clicksound = click_checkbox
			pdx_tooltip = BEL_decision_checkbox_hol_available_tooltip
			frame = 1
		}
		buttonType = {
			name = "decision_checkbox_hol_completed" 
			position = { x = @CHECKBOX_BUTTON_X y = @GUI_ELEMENTS_HOL_Y }
			quadTextureSprite = "GFX_deploy_priority"
			clicksound = click_checkbox
			pdx_tooltip = BEL_decision_checkbox_tooltip
			pdx_tooltip_delayed = BEL_decision_checkbox_completed
			frame = 4
		}

		instantTextBoxType = {
			name = "luxembourg_name"
			font = "garamond_24"
			text = "BEL_luxembourg_name"
			maxWidth = 220
			maxHeight = 24
			format = left
			position = { x = @COUNTRY_NAMES_X y = @GUI_ELEMENTS_LUX_Y }
		}

		iconType = {
			name = "count_icon2"
			spriteType = "GFX_div_count_bg"
			orientation = left
			position = { x = @COUNT_ICON_X y = 65 }
		}

		instantTextBoxType = {
			name = "integration_percentage2"
			font = "garamond_24"
			text = "integration_percentage_lux"
			maxWidth = 100
			format = left
			position = { x = @INTEGRATION_PERCENTAGE_X y = @GUI_ELEMENTS_LUX_Y }
		}

		iconType = {
			name = "decision_checkbox_lux_disable" 
			position = { x = @CHECKBOX_BUTTON_X y = @GUI_ELEMENTS_LUX_Y }
			quadTextureSprite = "GFX_deploy_priority"
			pdx_tooltip = BEL_decision_checkbox_tooltip
			pdx_tooltip_delayed = BEL_decision_checkbox_disabled
			frame = 2
		}
		iconType = {
			name = "decision_checkbox_lux_unavailable" 
			position = { x = @CHECKBOX_BUTTON_X y = @GUI_ELEMENTS_LUX_Y }
			quadTextureSprite = "GFX_deploy_priority"
			pdx_tooltip = BEL_decision_checkbox_lux_unavailable_tooltip
			frame = 3
		}
		buttonType = {
			name = "decision_checkbox_lux_available"
			position = { x = @CHECKBOX_BUTTON_X y = @GUI_ELEMENTS_LUX_Y }
			quadTextureSprite = "GFX_deploy_priority"
			clicksound = click_checkbox
			pdx_tooltip = BEL_decision_checkbox_lux_available_tooltip
			frame = 1
		}
		buttonType = {
			name = "decision_checkbox_lux_completed"
			position = { x = @CHECKBOX_BUTTON_X y = @GUI_ELEMENTS_LUX_Y }
			quadTextureSprite = "GFX_deploy_priority"
			clicksound = click_checkbox
			pdx_tooltip = BEL_decision_checkbox_tooltip
			pdx_tooltip_delayed = BEL_decision_checkbox_completed
			frame = 4
		}

		iconType = {
			name = "decision_help_button" 
			position = { x = 460 y = 55 }
			quadTextureSprite = "GFX_help_button"
			pdx_tooltip = BEL_decision_help_tooltip
		}
	}
}