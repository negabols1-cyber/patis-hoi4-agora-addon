@PEARL_X = 200
@PEARL_Y = -25

guiTypes = {

	containerWindowType = {
		name = "LIB_pearl_mining_decision_ui_window"
		position = { x = 0 y = 0 }
		size = { width = 100% height= 13 }
		
		instantTextBoxType = {
			name ="pearl"
			position = { x= @PEARL_X y = @PEARL_Y }
			font = "hoi_20b"
			text = "LIB_PEARL_VALUE"
